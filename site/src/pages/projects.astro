---
import Layout from "../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(
  projects.map(async (project) => ({
    project,
    Content: (await render(project)).Content,
  })),
);
---

<Layout title="projects — fosskar" description="projects by fosskar">
  <h1>projects</h1>
  <div class="stack">
    {
      rendered.map(({ project, Content }) => (
        <section class="card project">
          <h2>
            {project.data.url ? (
              <a href={project.data.url}>{project.data.title}</a>
            ) : (
              project.data.title
            )}
          </h2>
          <p class="muted desc">{project.data.description}</p>
          <Content />
          {project.data.repo && (
            <a class="source" href={project.data.repo}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="16 18 22 12 16 6" />
                <polyline points="8 6 2 12 8 18" />
              </svg>
              source
            </a>
          )}
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .project h2 {
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
  }
  .project h2 a {
    color: var(--text);
    text-decoration: none;
  }
  .project h2 a:hover {
    color: var(--accent);
  }
  .muted {
    color: var(--muted);
  }
  .desc {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }
  .source {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .source:hover {
    color: var(--accent);
    border-color: var(--dim);
  }
  .source svg {
    width: 0.9rem;
    height: 0.9rem;
  }
</style>
