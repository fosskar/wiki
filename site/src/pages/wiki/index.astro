---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const all = await getCollection("wiki");
const sections = [...new Set(all.map((e) => e.id.split("/")[0]))].sort();
const byDir = (dir: string) =>
  all
    .filter((e) => e.id.startsWith(dir + "/") && e.data.type !== "index")
    .sort((a, b) => a.data.title.localeCompare(b.data.title));
const indexOf = (dir: string) => all.find((e) => e.id === dir);

function noteSlug(id: string): string {
  return id.split("/").pop()!;
}
---

<Layout title="wiki — fosskar" description="notes on nixos, kubernetes, homelab">
  <h1>wiki</h1>
  <p class="muted">
    working notes — the things i had to figure out once and refuse to figure
    out twice.
  </p>
  <div class="stack">
    {
      sections.map((dir) => (
        <section class="card">
          <h2>
            <a href={`/wiki/${dir}/`}>{dir}</a>
          </h2>
          {indexOf(dir)?.data.description && (
            <p class="muted desc">{indexOf(dir)!.data.description}</p>
          )}
          <ul class="notes">
            {byDir(dir).map((note) => (
              <li>
                <a href={`/wiki/${noteSlug(note.id)}/`}>{note.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .muted {
    color: var(--muted);
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .card h2 {
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
  }
  .card h2 a {
    color: var(--text);
    text-decoration: none;
  }
  .card h2 a:hover {
    color: var(--accent);
  }
  .desc {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }
  .notes {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .notes a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .notes a:hover {
    color: var(--accent);
  }
  .notes li::before {
    content: "·";
    color: var(--dim);
    margin-right: 0.5rem;
  }
</style>
