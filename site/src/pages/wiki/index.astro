---
import Layout from "../../layouts/Layout.astro";
import WikiTree from "../../components/WikiTree.astro";
import { getCollection } from "astro:content";

const all = await getCollection("wiki");
---

<Layout
  title="wiki — fosskar"
  description="half blog, half wiki — practical notes and troubleshooting writeups"
>
  <h1>wiki</h1>
  <p class="muted">
    half blog, half wiki. most pages start from a real problem: a machine that
    needed fixing, or a setup annoying enough to document. the point is to keep
    the useful part — what worked, why it worked, and what tradeoff was being
    made.
  </p>
  <nav class="wiki-index" aria-label="wiki notes">
    <WikiTree notes={all} index />
  </nav>
</Layout>

<style>
  .muted {
    color: var(--muted);
  }
  .wiki-index {
    margin-top: 1.5rem;
  }
</style>
