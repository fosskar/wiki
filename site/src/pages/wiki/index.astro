---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

// section metadata lives here so folders need no index.md
const SECTIONS: Record<string, string> = {
  nixos: "NixOS-specific system, security, and troubleshooting notes",
  kubernetes:
    "talos, cilium, cluster api, networking, gitops, and local development notes",
  homelab: "proxmox, networking, identity, storage, and infrastructure notes",
  security:
    "hardware tokens, authentication, encryption, and key management notes",
};

const all = await getCollection("wiki");
const found = [...new Set(all.map((e) => e.id.split("/")[0]))];
const sections = [
  ...Object.keys(SECTIONS).filter((s) => found.includes(s)),
  ...found.filter((s) => !(s in SECTIONS)).sort(),
];

// within a section, group notes by subdirectory ("" = section root)
function groupsOf(dir: string): [string, typeof all][] {
  const notes = all
    .filter((e) => e.id.startsWith(dir + "/"))
    .sort((a, b) => a.data.title.localeCompare(b.data.title));
  const groups = new Map<string, typeof all>();
  for (const note of notes) {
    const parts = note.id.split("/");
    const sub = parts.slice(1, -1).join("/");
    if (!groups.has(sub)) groups.set(sub, []);
    groups.get(sub)!.push(note);
  }
  return [...groups.entries()].sort(([a], [b]) => a.localeCompare(b));
}

function noteSlug(id: string): string {
  return id.split("/").pop()!;
}
---

<Layout
  title="wiki — fosskar"
  description="half blog, half wiki — practical notes and troubleshooting writeups"
>
  <h1>wiki</h1>
  <p class="muted">
    half blog, half wiki. most pages start from a real problem: a machine that
    needed fixing, or a setup annoying enough to document. the point is to keep
    the useful part — what worked, why it worked, and what tradeoff was being
    made.
  </p>
  <div class="stack">
    {
      sections.map((dir) => (
        <section class="card" id={dir}>
          <h2>{dir}</h2>
          {SECTIONS[dir] && <p class="muted desc">{SECTIONS[dir]}</p>}
          {groupsOf(dir).map(([sub, notes]) => (
            <>
              {sub && <h3 class="subgroup">{sub}</h3>}
              <ul class="notes">
                {notes.map((note) => (
                  <li>
                    <a href={`/wiki/${noteSlug(note.id)}/`}>
                      {note.data.title}
                    </a>
                    {note.data.type !== "note" && (
                      <span class="type">{note.data.type}</span>
                    )}
                  </li>
                ))}
              </ul>
            </>
          ))}
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .muted {
    color: var(--muted);
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .card h2 {
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
  }
  .desc {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }
  .subgroup {
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--dim);
  }
  .notes {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .notes a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .notes a:hover {
    color: var(--accent);
  }
  .notes li::before {
    content: "·";
    color: var(--dim);
    margin-right: 0.5rem;
  }
  .type {
    margin-left: 0.5rem;
    font-size: 0.7rem;
    color: var(--dim);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
    vertical-align: middle;
  }
</style>
