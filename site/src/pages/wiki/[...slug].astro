---
import Layout from "../../layouts/Layout.astro";
import ArticleHead from "../../components/ArticleHead.astro";
import WikiTree from "../../components/WikiTree.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import {
  assertUniqueSlugs,
  sectionHref,
  sectionOf,
  slugOf,
} from "../../lib/notes";

export async function getStaticPaths() {
  const entries = await getCollection("wiki");
  assertUniqueSlugs(entries.map((e) => e.id));
  return entries.map((entry) => ({
    params: { slug: slugOf(entry.id) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"wiki">;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const section = sectionOf(entry.id);
const all = await getCollection("wiki");
const toc = (entry.data.enableToc ?? true)
  ? headings.filter((h) => h.depth >= 2 && h.depth <= 3)
  : [];
---

<Layout title={`${entry.data.title} — fosskar`} description={entry.data.description}>
  <nav class="wiki-sidebar" aria-label="wiki notes">
    <WikiTree notes={all} current={entry.id} />
  </nav>
  <details class="wiki-browse">
    <summary>browse wiki</summary>
    <WikiTree notes={all} current={entry.id} />
  </details>
  <article>
    <ArticleHead
      title={entry.data.title}
      description={entry.data.description}
      date={entry.data.date}
      datePrefix="last verified"
    >
      <Fragment slot="topline">
        <a href="/wiki/">wiki</a> / <a href={sectionHref(section)}>{section}</a>
      </Fragment>
      <Fragment slot="chips">
        {entry.data.type !== "note" && <span class="chip">{entry.data.type}</span>}
      </Fragment>
    </ArticleHead>
    <Content />
  </article>
  {
    toc.length > 1 && (
      <nav class="toc" aria-label="table of contents">
        <span class="toc-title">on this page</span>
        <ul>
          {toc.map((h) => (
            <li class={`depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</Layout>

<style>
  .wiki-sidebar {
    display: none;
    position: fixed;
    top: 6rem;
    /* left gutter, mirrors .toc */
    right: calc(50% + 24rem);
    width: 15rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .wiki-browse {
    margin-bottom: 1.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.9rem;
  }
  .wiki-browse > summary {
    cursor: pointer;
    color: var(--muted);
  }
  .wiki-browse[open] > summary {
    margin-bottom: 0.5rem;
  }
  @media (min-width: 82rem) {
    .wiki-sidebar {
      display: block;
    }
    .wiki-browse {
      display: none;
    }
  }
  .toc {
    display: none;
    position: fixed;
    top: 6rem;
    /* right gutter: main column is 46rem centered */
    left: calc(50% + 24rem);
    width: 15rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  /* only when the gutter actually fits: 46rem column + 2x16rem gutters */
  @media (min-width: 82rem) {
    .toc {
      display: block;
    }
  }
  .toc-title {
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    border-left: 1px solid var(--border);
  }
  .toc li {
    padding: 0.125rem 0 0.125rem 0.75rem;
  }
  .toc li.depth-3 {
    padding-left: 1.75rem;
  }
  .toc a {
    color: var(--muted);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--accent-bright);
  }
</style>
