---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("wiki");
  return entries.map((entry) => {
    // glob loader strips "index.md": dir indexes get id = dir path.
    // dir index pages route as /wiki/<dir-path>, notes flat as /wiki/<basename>
    const isIndex = entry.filePath?.endsWith("/index.md") ?? false;
    const slug = isIndex ? entry.id : entry.id.split("/").pop()!;
    return { params: { slug }, props: { entry } };
  });
}

interface Props {
  entry: CollectionEntry<"wiki">;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const section = entry.id.split("/")[0];
const toc = (entry.data.enableToc ?? true)
  ? headings.filter((h) => h.depth >= 2 && h.depth <= 3)
  : [];
---

<Layout title={`${entry.data.title} — fosskar`} description={entry.data.description}>
  <article>
    <p class="crumbs">
      <a href="/wiki/">wiki</a> / <a href={`/wiki/${section}/`}>{section}</a>
    </p>
    <h1>{entry.data.title}</h1>
    <p class="meta">
      {entry.data.date && <time>{entry.data.date.toISOString().slice(0, 10)}</time>}
      {entry.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
    </p>
    <Content />
  </article>
  {
    toc.length > 1 && (
      <nav class="toc" aria-label="table of contents">
        <span class="toc-title">on this page</span>
        <ul>
          {toc.map((h) => (
            <li class={`depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</Layout>

<style>
  .crumbs {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .crumbs a {
    color: var(--muted);
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .tag {
    color: var(--accent-secondary);
  }
  .toc {
    display: none;
    position: fixed;
    top: 6rem;
    /* right gutter: main column is 46rem centered */
    left: calc(50% + 24rem);
    width: 15rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  /* only when the gutter actually fits: 46rem column + 2x16rem gutters */
  @media (min-width: 82rem) {
    .toc {
      display: block;
    }
  }
  .toc-title {
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    border-left: 1px solid var(--border);
  }
  .toc li {
    padding: 0.15rem 0 0.15rem 0.75rem;
  }
  .toc li.depth-3 {
    padding-left: 1.75rem;
  }
  .toc a {
    color: var(--muted);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--accent-bright);
  }
</style>
