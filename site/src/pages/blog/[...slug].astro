---
import Layout from "../../layouts/Layout.astro";
import ArticleHead from "../../components/ArticleHead.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { published, postSlug } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = published(await getCollection("blog"));
  return posts.map((post) => ({
    params: { slug: postSlug(post.id) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — fosskar`} description={post.data.description}>
  <article>
    <ArticleHead
      title={post.data.title}
      description={post.data.description}
      date={post.data.date}
    >
      <a slot="topline" href="/blog/">← blog</a>
      <Fragment slot="chips">
        {post.data.tags.map((tag) => <span class="chip">#{tag}</span>)}
      </Fragment>
    </ArticleHead>
    <Content />
  </article>
</Layout>
