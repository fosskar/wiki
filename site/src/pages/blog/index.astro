---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="blog — fosskar" description="posts by fosskar">
  <h1>blog</h1>
  <div class="stack">
    {
      posts.map((post) => (
        <a class="card entry" href={`/blog/${post.id.replace(/\.md$/, "")}/`}>
          <span class="entry-title">{post.data.title}</span>
          {post.data.description && (
            <span class="entry-desc">{post.data.description}</span>
          )}
          <span class="meta">
            <time>{post.data.date.toISOString().slice(0, 10)}</time>
          </span>
        </a>
      ))
    }
  </div>
</Layout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .entry-title {
    font-weight: 600;
    color: var(--text);
  }
  .entry:hover .entry-title {
    color: var(--accent);
  }
  .entry-desc {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .entry .meta {
    margin: 0;
  }
</style>
