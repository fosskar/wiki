---
interface Props {
  buttons?: boolean;
}
const { buttons = false } = Astro.props;
const links = [
  {
    href: "https://github.com/fosskar",
    label: "github",
    // lucide: github
    paths: [
      "M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4",
      "M9 18c-4.51 2-5-2-7-2",
    ],
  },
  {
    href: "https://codeberg.org/fosskar",
    label: "codeberg",
    // lucide: mountain
    paths: ["m8 3 4 8 5-5 5 15H2L8 3z"],
  },
  {
    href: "https://radicle.fosskar.eu",
    label: "radicle",
    // lucide: sprout
    paths: [
      "M7 20h10",
      "M10 20c5.5-2.5.8-6.4 3-10",
      "M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z",
      "M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z",
    ],
  },
  {
    href: "https://matrix.to/#/@fosscar:matrix.org",
    label: "matrix",
    // [m] brackets + strokes
    paths: [
      "M7 3H4v18h3",
      "M17 3h3v18h-3",
      "M9 15v-4.5a1.5 1.5 0 0 1 3 0V15",
      "M12 12a1.5 1.5 0 0 1 3 0v3",
    ],
  },
  {
    href: "/rss.xml",
    label: "rss",
    // lucide: rss
    paths: [
      "M4 11a9 9 0 0 1 9 9",
      "M4 4a16 16 0 0 1 16 16",
      "M4.5 19.5m-.5 0a.5.5 0 1 0 1 0a.5.5 0 1 0-1 0",
    ],
  },
];
---

<div class:list={["social", { buttons }]}>
  {
    links.map((link) => (
      <a href={link.href} aria-label={link.label} title={link.label}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          {link.paths.map((d) => (
            <path d={d} />
          ))}
        </svg>
      </a>
    ))
  }
</div>

<style>
  .social {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .social a:hover {
    color: var(--accent);
  }
  .social svg {
    width: 1rem;
    height: 1rem;
  }
  /* circular bordered buttons (hero variant) */
  .social.buttons {
    gap: 0.6rem;
  }
  .social.buttons a {
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-alt);
  }
  .social.buttons a:hover {
    color: var(--accent);
    border-color: var(--dim);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-alt));
  }
  .social.buttons svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
