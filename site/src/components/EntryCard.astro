---
// entry card for post/note listings; compact renders title and date on one row
interface Props {
  href: string;
  title: string;
  description?: string;
  date?: Date;
  compact?: boolean;
}
const { href, title, description, date, compact = false } = Astro.props;
---

<a class:list={["card", "entry", { compact }]} href={href}>
  <span class="entry-title">{title}</span>
  {description && <span class="entry-desc">{description}</span>}
  {
    date && (
      <span class="meta">
        <time datetime={date.toISOString().slice(0, 10)}>
          {date.toISOString().slice(0, 10)}
        </time>
      </span>
    )
  }
</a>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .entry-title {
    font-weight: 600;
    color: var(--text);
  }
  .entry:hover .entry-title {
    color: var(--accent);
  }
  .entry-desc {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .entry .meta {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .entry.compact {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
  }
  .entry.compact .entry-title {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .entry.compact .meta {
    flex-shrink: 0;
  }
</style>
