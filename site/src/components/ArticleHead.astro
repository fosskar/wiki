---
// shared article header for wiki notes and blog posts: topline slot
// (crumbs / back link), title, description, calendar date, meta chips slot
interface Props {
  title: string;
  description?: string;
  date?: Date;
  datePrefix?: string;
}
const { title, description, date, datePrefix = "" } = Astro.props;
---

<header class="article-head">
  <p class="topline"><slot name="topline" /></p>
  <h1>{title}</h1>
  {description && <p class="desc">{description}</p>}
  <div class="meta">
    {
      date && (
        <span class="date">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M8 2v4" />
            <path d="M16 2v4" />
            <rect width="18" height="18" x="3" y="4" rx="2" />
            <path d="M3 10h18" />
          </svg>
          <time datetime={date.toISOString().slice(0, 10)}>
            {datePrefix}
            {date.toISOString().slice(0, 10)}
          </time>
        </span>
      )
    }
    <slot name="chips" />
  </div>
</header>

<style>
  .article-head {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .article-head h1 {
    font-size: 2.1rem;
    margin: 0 0 0.35rem;
  }
  .topline {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }
  .topline :global(a) {
    color: var(--muted);
    text-decoration: none;
  }
  .topline :global(a:hover) {
    color: var(--accent);
  }
  .desc {
    color: var(--muted);
    margin: 0 0 0.75rem;
  }
  .date {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .date svg {
    width: 0.9rem;
    height: 0.9rem;
  }
</style>
